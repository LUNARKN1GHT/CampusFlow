# Local configuration and credentials
.env
.env.*
!.env.example

# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend and build output
node_modules/
dist/
build/
*.tsbuildinfo
playwright-report/
