# CampusFlow 后端配置样例。
# 使用方法：复制本文件为 backend/.env，按需填写；.env 已被 .gitignore 忽略，切勿提交仓库。
# 环境变量优先于 .env 文件中的值。

# 应用名称（config.py 已支持）
CAMPUSFLOW_APP_NAME=CampusFlow API

# 桌面分发（P004）：desktop 使用绝对数据目录、同源静态站点与数据库 Worker
# CAMPUSFLOW_DEPLOYMENT_MODE=desktop
# CAMPUSFLOW_DATA_DIR=/Users/you/Library/Application Support/CampusFlow

# 桌面首启（P007）：内置 PostgreSQL 二进制目录（initdb/pg_ctl/pg_isready），不填用 PATH；
# 密钥链不可用时退回 0600 凭据文件，不会使用默认 student/campusflow-dev
# CAMPUSFLOW_PG_BIN=/path/to/postgresql/bin
# CAMPUSFLOW_SECRET_BACKEND=auto

# 数据库与 Redis（接入持久化后生效；值需与 infra/docker-compose.yml 保持一致）
CAMPUSFLOW_DATABASE_URL=postgresql+psycopg://campusflow:campusflow@127.0.0.1:5432/campusflow
CAMPUSFLOW_TEST_DATABASE_URL=postgresql+psycopg://campusflow:campusflow@127.0.0.1:5432/campusflow_test
CAMPUSFLOW_REDIS_URL=redis://127.0.0.1:6379/0

# 启动时重投待投递作业（J004 投递补偿）；设为 false 则只保留手动重投入口
CAMPUSFLOW_DISPATCH_ON_STARTUP=true

# 作业超时（秒，J005）： Worker 崩溃/卡死后，处理中作业超过该时长会被回收为可重试失败
CAMPUSFLOW_JOB_TIMEOUT_SECONDS=900

# 本机单用户登录；共享环境必须替换默认值
CAMPUSFLOW_LOCAL_USERNAME=student
CAMPUSFLOW_LOCAL_PASSWORD=campusflow-dev

# 模型服务密钥（接入模型适配器后由对应适配器直接读取；未填写时不得调用真实模型）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# X002：文字生成与图片识别的模型分别配置
CAMPUSFLOW_TEXT_MODEL=glm-4-flash-250414
CAMPUSFLOW_TEXT_TIMEOUT_SECONDS=60
CAMPUSFLOW_TEXT_MAX_TOKENS=4096

# Q019：文字生成供应方（zhipu 或 deepseek）；deepseek 需填写 DEEPSEEK_API_KEY。
# 使用 DeepSeek 时把 CAMPUSFLOW_TEXT_MODEL 改为 deepseek-chat 等对应型号。
CAMPUSFLOW_TEXT_PROVIDER=zhipu

# Q002：独立的向量设置；构造不联网，显式生成才调用。更换代次需重建索引。
CAMPUSFLOW_EMBEDDING_MODEL=embedding-3
CAMPUSFLOW_EMBEDDING_REVISION=q001-v1
CAMPUSFLOW_EMBEDDING_DIMENSIONS=1024
CAMPUSFLOW_EMBEDDING_TIMEOUT_SECONDS=60

# Q009：视觉识别超时与重试上限；0 次重试表示只调用一次。最坏等待仍低于作业超时。
CAMPUSFLOW_VISION_TIMEOUT_SECONDS=60
CAMPUSFLOW_VISION_MAX_RETRIES=2
CAMPUSFLOW_VISION_RETRY_BACKOFF_SECONDS=1

# API 与 Docker Worker 必须读取同一批文件。默认 API 从 backend/ 启动。
CAMPUSFLOW_STORAGE_DIR=data/materials
# 修改存储目录时，在启动 Compose 的终端指定同一宿主机绝对路径：
# CAMPUSFLOW_HOST_STORAGE_DIR=C:/path/to/private/materials
# Docker Desktop Worker 的连接覆盖项（仅在自定义连接时需要）：
# CAMPUSFLOW_WORKER_DATABASE_URL=postgresql+psycopg://user:password@host.docker.internal:5432/database
# CAMPUSFLOW_WORKER_REDIS_URL=redis://host.docker.internal:6379/0

# M9：外部日历。生产使用 google；local 只是显式本地模拟，不代表真实外部同步。
CAMPUSFLOW_CALENDAR_PROVIDER=google
# 用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成
CAMPUSFLOW_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/oauth/callback
